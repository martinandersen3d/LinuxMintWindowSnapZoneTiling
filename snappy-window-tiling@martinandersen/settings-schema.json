{
    "layout": {
        "type": "layout",
        "pages": ["main"],
        "main": {
            "type": "page",
            "title": "Shortcuts",
            "sections": ["shortcuts-section"]
        }
    },
    "shortcuts-section": {
        "type": "section",
        "title": "Keyboard Shortcuts",
        "keys": ["toggle-snappy-window-tiling"]
    },
    "toggle-snappy-window-tiling": {
        "type": "keybinding",
        "description": "Snappy Window Tiling",
        "default": "<Super>z"
    }
}